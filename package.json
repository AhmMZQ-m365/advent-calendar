{
  "name": "advent-calendar",
  "version": "2.0.0",
  "description": "Interactive Advent calendar web part for SharePoint Online (SPFx): 24 doors on a Christmas tree or a grid, built-in administration, auto-provisioned lists, English and French.",
  "license": "MIT",
  "author": {
    "name": "MARZAQ Ahmed",
    "url": "https://marzaqconsulting.fr/"
  },
  "homepage": "https://marzaqconsulting.fr/",
  "keywords": [
    "sharepoint",
    "sharepoint-online",
    "spfx",
    "sharepoint-framework",
    "web-part",
    "advent-calendar",
    "christmas",
    "intranet",
    "react",
    "pnpjs"
  ],
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "loc": "node scripts/sync-loc.js",
    "build": "npm run loc && heft test --clean --production && heft package-solution --production",
    "bundle": "npm run loc && heft build --clean --production",
    "package-solution": "heft package-solution --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "npm run loc && heft start --clean"
  },
  "dependencies": {
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@pnp/core": "^4.22.0",
    "@pnp/logging": "^4.22.0",
    "@pnp/queryable": "^4.22.0",
    "@pnp/sp": "^4.22.0",
    "dompurify": "^3.4.17",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
}
